{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills Consumer Lock",
  "type": "object",
  "required": ["source", "ref", "commitSha", "skills"],
  "additionalProperties": false,
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["treeSha", "contentSha256", "path"],
        "additionalProperties": false,
        "properties": {
          "treeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "path": {"type": "string", "pattern": "^\\.github/skills/"}
        }
      }
    }
  }
}
